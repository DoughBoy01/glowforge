# Copy to .env.local for `next dev`, and to .dev.vars for `wrangler`/OpenNext
# local preview. In production these are set as Worker secrets/vars — see
# README.md "Deploying" for the exact commands.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Clerk (auth) ---------------------------------------------------------
# https://dashboard.clerk.com — Configure → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Configure → Webhooks → add endpoint /api/webhooks/clerk, subscribe to
# user.created / user.updated / user.deleted, copy the signing secret.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# --- Stripe (billing) ------------------------------------------------------
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price id for the Pro subscription plan (Products → Pro → pricing).
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_xxx

# --- PostHog (analytics) ----------------------------------------------------
# https://app.posthog.com/project/settings — Project API key
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- YouCam (AI skin analysis) ----------------------------------------------
# https://yce.makeupar.com/api-console/en/api-keys/ — v2 API key, sent as a
# Bearer token. No client secret / token exchange needed (v1-only, deprecated).
YOUCAM_API_KEY=xxx
